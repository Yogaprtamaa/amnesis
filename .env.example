# amnesis — copy ke .env di root project dan isi yang dipakai (JANGAN commit .env)
# cp .env.example .env
# File .env otomatis dibaca tiap command amnesis jalan (tidak perlu export manual).

# --- Anthropic (default provider, lihat .aimemory/config.json) ---
# Dipakai oleh: amnesis wrapup
# Dapat key di: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- OpenCode Zen / Big Pickle (GRATIS, unlimited) ---
# Buat key di dashboard OpenCode → API Keys: https://opencode.ai/
# Lalu: amnesis wrapup --provider=opencode
OPENCODE_API_KEY=

# --- OpenRouter (GRATIS — rekomendasi buat user baru) ---
# Daftar gratis (tanpa kartu kredit) di: https://openrouter.ai/
# Pakai model ":free", mis. qwen/qwen-2.5-coder-32b-instruct:free
# Lalu: amnesis wrapup --provider=openrouter
OPENROUTER_API_KEY=

# --- OpenAI (kalau pakai --provider=openai / "provider": "openai") ---
# Dapat key di: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Ollama (lokal, gratis, tanpa key) ---
# Jalankan dulu: ollama serve && ollama pull llama3.1
# Lalu: amnesis wrapup --provider=ollama
# (tidak perlu env var apapun)
